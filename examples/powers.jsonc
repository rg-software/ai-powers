// OPTIONAL project adapter for the he9-* skills.
//
// You usually do not need this file. The skills probe the standard layout and
// infer the rest:
//
//   baseBranch : from origin/HEAD, else "main"
//   conventions: openspec/conventions.md      (if present)
//   specs      : openspec/specs/*/spec.md     (if present)
//   debt       : openspec/technical-debt.md   (if present)
//   docs       : docs/*.md                    (if present)
//   tracker    : auto — explicit here, else the git remote host, else ask.
//                A forge name, not a tool: "github" | "gitea" | "gitlab".
//                Resolved to a CLI (gh / tea / glab). Set it when the issues
//                for a repo live somewhere other than its git remote.
//   contract   : he9-review-contract
//
// Create this file only to OVERRIDE one of those. Anything you omit is probed.
// Nothing here is machine-specific (tokens and hosts come from env / the forge).
{
  // "baseBranch": "develop",
  // "conventions": "docs/conventions.md",
  // "specs": "specs/*/spec.md",
  // "debt": "openspec/tech-debt.md",
  // "docs": ["docs/*.md", "design/*.md"],
  // "tracker": "github",
  // "contract": "he9-review-contract"
}
