// Example local reviewer agent, required by `he9-review` and `he9-debt scan`.
//
// Merge the "agent" block into the project's opencode.jsonc (or
// .opencode/opencode.json) -- do not overwrite the file, which usually carries
// other settings. The key is `agent` (singular); `agents` is silently ignored.
// Set REVIEWER_MODEL in your shell, then restart opencode.
//
// The model id is intentionally not committed: it is machine-specific.
{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "reviewer": {
      "mode": "subagent",
      "description": "Reviews code for best practices.",
      "model": "{env:REVIEWER_MODEL}",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  }
}